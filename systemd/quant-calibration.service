[Unit]
Description=Model calibration — score past predictions, compute coverage/bias/IC (C4 fix, 2026-09-10)
Documentation=file:///data2/quant/docs/AUDIT-20260910.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/data2/quant
EnvironmentFile=/data2/quant/secrets/secrets.env
ExecStart=/data2/quant/venv/bin/python -m quant.calibration
StandardOutput=append:/data2/quant/logs/calibration.log
StandardError=append:/data2/quant/logs/calibration.err
TimeoutStartSec=900
