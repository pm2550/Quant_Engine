[Unit]
Description=Quant news event monitor (RSS + LLM impact推演)
After=network-online.target dashscope-proxy.service quant-api.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/data2/quant
EnvironmentFile=/data2/quant/secrets/secrets.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/data2/quant/venv/bin/python -m quant.newswatch --interval 300 --threshold 9
Restart=always
RestartSec=30
Nice=10
StandardOutput=append:/data2/quant/logs/newswatch.log
StandardError=append:/data2/quant/logs/newswatch.err

[Install]
WantedBy=multi-user.target
