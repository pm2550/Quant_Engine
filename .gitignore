# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Virtual env (1.4 GB, not source)
venv/
.venv/

# Secrets — CRITICAL: never commit API keys
secrets/

# Database (47 MB SQLite + WAL)
db/*.sqlite
db/*.sqlite-shm
db/*.sqlite-wal

# Historical price data (10 MB parquets, can be re-fetched)
data/prices/*.parquet

# Logs
logs/

# Daily state files (regenerated by daily.py runs)
results/

# Auto-generated reports (regenerated each daily run)
reports/

# Auto-generated dynamic universe (overwritten by universe_discovery timer)
config/dynamic_universe.yaml

# Personal config — has API keys + portfolio holdings + telegram chat ID.
# Each repo user should `cp <name>.example.yaml <name>.yaml` and fill in.
config/llm.yaml
config/portfolio.yaml

# Backups (191 MB — old shim scripts, .bak files)
backups/

# Empty placeholder dirs
api/
workers/

# Misc
*.swp
*.swo
.DS_Store
.env.local

# ML challenger sandbox (separate aarch64-friendly venv + qlib source clone + model output)
qlib_env/
qlib_src/
results/challenger_*.json

# Trained models (binary, retrained weekly)
models/
